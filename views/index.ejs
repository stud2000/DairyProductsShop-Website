<%- include('partials/head', { title: 'Home' }) %>
<%- include('partials/navbar') %>

<% if (flash.success && flash.success.length) { %>
  <div class="flash-container"><div class="flash flash-success"><%= flash.success[0] %></div></div>
<% } %>
<% if (flash.error && flash.error.length) { %>
  <div class="flash-container"><div class="flash flash-error"><%= flash.error[0] %></div></div>
<% } %>

<!-- HERO -->
<section class="hero">
  <div class="hero-inner">
    <div class="hero-content">
      <div class="hero-eyebrow">Freshly Delivered Every Morning</div>
      <h1>Pure Dairy, Straight from the Farm</h1>
      <p>Experience the goodness of nature with our farm-fresh milk, ghee, paneer, curd and more — pure, natural and delivered to your doorstep daily.</p>
      <div class="hero-btns">
        <a href="/products" class="btn btn-primary">Shop Products</a>
        <a href="/contact" class="btn btn-outline">Send Inquiry</a>
      </div>
      <div class="hero-stats">
        <div><div class="stat-num">38+</div><div class="stat-label">Years of Trust</div></div>
        <div><div class="stat-num"><%= totalProducts %>+</div><div class="stat-label">Products</div></div>
        <div><div class="stat-num">5,000+</div><div class="stat-label">Happy Families</div></div>
        <div><div class="stat-num">100%</div><div class="stat-label">Pure &amp; Natural</div></div>
      </div>
    </div>
    <div class="hero-products">
      <div class="hero-product-card">
        <div class="product-icon">🥛</div>
        <div class="product-label">Fresh Milk</div>
        <div class="product-price">from ₹30 / 500ml</div>
      </div>
      <div class="hero-product-card">
        <div class="product-icon">✨</div>
        <div class="product-label">Pure Ghee</div>
        <div class="product-price">from ₹180 / 250ml</div>
      </div>
      <div class="hero-product-card">
        <div class="product-icon">🧀</div>
        <div class="product-label">Fresh Paneer</div>
        <div class="product-price">from ₹80 / 200g</div>
      </div>
      <div class="hero-product-card">
        <div class="product-icon">🍦</div>
        <div class="product-label">Ice Cream</div>
        <div class="product-price">from ₹30 / cup</div>
      </div>
    </div>
  </div>
</section>

<!-- FEATURED PRODUCTS -->
<section class="section" style="background: var(--white);">
  <div class="container">
    <div class="section-header">
      <div class="eyebrow">Our Bestsellers</div>
      <h2>Featured Products</h2>
      <p>Handpicked freshness from our farm to your table. Every product is made with care and tested for quality.</p>
    </div>

    <% if (featured.length > 0) { %>
      <div class="products-grid">
        <% featured.forEach(product => { %>
          <div class="product-card">
            <% if (product.badge) { %>
              <div class="product-badge <%= product.badge.toLowerCase().includes('new') ? 'new' : '' %>"><%= product.badge %></div>
            <% } %>
            <% const catEmoji = { 'Milk': '🥛', 'Ghee': '✨', 'Paneer': '🧀', 'Curd': '🥣', 'Butter': '🧈', 'Ice Cream': '🍦', 'Lassi': '🥤', 'Cheese': '🧀', 'Cream': '🍶', 'Other': '🐄' }; %>
            <% if (product.image && product.image !== 'default-product.jpg') { %>
              <img src="/uploads/<%= product.image %>" alt="<%= product.name %>" class="product-img">
            <% } else { %>
              <div class="product-img-placeholder"><%= catEmoji[product.category] || '🐄' %></div>
            <% } %>
            <div class="product-body">
              <div class="product-category"><%= product.category %></div>
              <div class="product-name"><%= product.name %></div>
              <div class="product-desc"><%= product.description %></div>
              <div class="product-variants">
                <% product.variants.slice(0, 3).forEach(v => { %>
                  <span class="variant-pill"><%= v.quantity %> — <strong>₹<%= v.price %></strong></span>
                <% }) %>
              </div>
              <div class="product-footer">
                <div class="product-price">₹<%= product.variants[0] ? product.variants[0].price : '—' %><small> / <%= product.variants[0] ? product.variants[0].quantity : '' %></small></div>
                <a href="/products/<%= product._id %>" class="btn btn-primary btn-sm">View</a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
      <div style="margin-top: 36px; text-align: center;">
        <a href="/products" class="btn btn-outline">View All Products</a>
      </div>
    <% } else { %>
      <div class="empty-state"><div class="empty-icon">🐄</div><h3>Products Coming Soon</h3></div>
    <% } %>
  </div>
</section>

<!-- WHY CHOOSE US -->
<section class="section why-section">
  <div class="container">
    <div class="section-header centered">
      <div class="eyebrow">Why Choose Us</div>
      <h2>The Shree Dairy Difference</h2>
      <p>Four decades of delivering purity and freshness to families across the region.</p>
    </div>
    <div class="why-grid">
      <div class="why-card">
        <div class="why-icon">🌾</div>
        <h3>Farm Fresh Daily</h3>
        <p>All products are prepared fresh every morning from our own farm. No preservatives, no additives — just pure goodness.</p>
      </div>
      <div class="why-card">
        <div class="why-icon">🧪</div>
        <h3>Quality Tested</h3>
        <p>Every batch is quality-checked before delivery. We maintain strict hygiene and safety standards throughout our process.</p>
      </div>
      <div class="why-card">
        <div class="why-icon">🚚</div>
        <h3>Daily Delivery</h3>
        <p>Morning delivery to your doorstep. Order before 8PM for next-morning delivery, 365 days a year.</p>
      </div>
      <div class="why-card">
        <div class="why-icon">💰</div>
        <h3>Fair Pricing</h3>
        <p>No middlemen. Direct from farm to you. Premium quality at prices that respect your pocket.</p>
      </div>
      <div class="why-card">
        <div class="why-icon">🐄</div>
        <h3>Happy Cows</h3>
        <p>Our cows are grass-fed, well-cared for and live stress-free. Happy cows produce better, healthier milk.</p>
      </div>
      <div class="why-card">
        <div class="why-icon">📦</div>
        <h3>Bulk Orders</h3>
        <p>Hotels, restaurants, hostels — we handle bulk orders too. Special rates for regular bulk customers.</p>
      </div>
    </div>
  </div>
</section>

<!-- CATEGORIES -->
<section class="section" style="background: var(--white);">
  <div class="container">
    <div class="section-header centered">
      <div class="eyebrow">Browse by Category</div>
      <h2>What We Offer</h2>
    </div>
    <div class="categories-grid">
      <% const catEmoji2 = { 'Milk': '🥛', 'Curd': '🥣', 'Butter': '🧈', 'Cheese': '🧀', 'Ghee': '✨', 'Paneer': '🧀', 'Ice Cream': '🍦', 'Lassi': '🥤', 'Cream': '🍶', 'Other': '🐄' }; %>
      <% categories.forEach(cat => { %>
        <a href="/products?category=<%= encodeURIComponent(cat) %>" class="cat-btn">
          <%= catEmoji2[cat] || '🐄' %> <%= cat %>
        </a>
      <% }) %>
    </div>
  </div>
</section>

