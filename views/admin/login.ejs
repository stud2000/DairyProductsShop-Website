<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login — Shree Dairy Farm</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="login-page">
  <div class="login-card">
    <div class="login-logo">🐄</div>
    <h1>Admin Panel</h1>
    <p>Shree Dairy Farm Management</p>

    <% if (flash.error && flash.error.length) { %>
      <div class="flash flash-error" style="text-align:left; margin-bottom:18px;"><%= flash.error[0] %></div>
    <% } %>
    <% if (flash.success && flash.success.length) { %>
      <div class="flash flash-success" style="text-align:left; margin-bottom:18px;"><%= flash.success[0] %></div>
    <% } %>

    <form action="/admin/login" method="POST" class="admin-form" style="text-align:left;">
      <div class="form-group">
        <label>Email Address</label>
        <input type="email" name="email" placeholder="admin@dairyshop.com" required>
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" placeholder="••••••••" required>
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%; justify-content:center; padding:12px;">
        Sign In
      </button>
    </form>

    <p style="margin-top:20px; font-size:11px; color:var(--text-light);">
      Default: admin@dairyshop.com / Admin@123
    </p>
    <a href="/" style="display:block; margin-top:10px; font-size:12px; color:var(--text-light);">← Back to Website</a>
  </div>
</div>
<script src="/js/admin.js"></script>
</body>
</html>
