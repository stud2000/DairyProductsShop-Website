<%- include('partials/head', { title: 'Contact Us' }) %>
<%- include('partials/navbar') %>

<div class="page-header">
  <div class="container">
    <h1>Contact &amp; Inquiry</h1>
    <p>We'd love to hear from you — orders, bulk inquiries, feedback or just saying hello.</p>
    <div class="breadcrumb"><a href="/">Home</a> <span>/</span> Contact</div>
  </div>
</div>

<% if (flash.success && flash.success.length) { %>
  <div class="flash-container"><div class="flash flash-success"><%= flash.success[0] %></div></div>
<% } %>
<% if (flash.error && flash.error.length) { %>
  <div class="flash-container"><div class="flash flash-error"><%= flash.error[0] %></div></div>
<% } %>

<section class="section contact-section">
  <div class="container">
    <div class="contact-grid">
      <div>
        <h2 style="font-family:'Lora',serif; color:var(--brown); margin-bottom:12px; font-size:1.6rem;">Get in Touch</h2>
        <p style="color:var(--text-mid); line-height:1.8; margin-bottom:32px; font-size:15px;">Whether you have a question about our products, want to place a bulk order, need delivery information, or just want to share your feedback — we're here for you.</p>

        <div class="info-card">
          <div class="info-icon">📍</div>
          <div>
            <h4>Visit Our Shop</h4>
            <p>123, Dairy Lane, Near Bus Stand<br>Solapur, Maharashtra – 413001</p>
          </div>
        </div>
        <div class="info-card">
          <div class="info-icon">📞</div>
          <div>
            <h4>Call Us</h4>
            <p><a href="tel:+919876543210" style="color:var(--brown); font-weight:700; font-size:17px;">+91 98765 43210</a><br>
            <a href="tel:+910212345678" style="color:var(--text-mid);">0212-234567</a></p>
          </div>
        </div>
        <div class="info-card">
          <div class="info-icon">💬</div>
          <div>
            <h4>WhatsApp</h4>
            <p><a href="https://wa.me/919876543210" style="color:var(--green); font-weight:600;">wa.me/919876543210</a><br>
            <span style="font-size:13px; color:var(--text-light);">Quick responses on WhatsApp</span></p>
          </div>
        </div>
        <div class="info-card">
          <div class="info-icon">📧</div>
          <div>
            <h4>Email</h4>
            <p><a href="mailto:info@shreedairy.com" style="color:var(--brown);">info@shreedairy.com</a></p>
          </div>
        </div>
        <div class="info-card">
          <div class="info-icon">🕐</div>
          <div>
            <h4>Working Hours</h4>
            <table class="hours-table">
              <tr><td>Mon – Sat</td><td>6:00 AM – 9:00 PM</td></tr>
              <tr><td>Sunday</td><td>6:00 AM – 1:00 PM</td></tr>
            </table>
          </div>
        </div>
      </div>

      <div>
        <div style="background:var(--white); border-radius:var(--radius); padding:36px; box-shadow:var(--shadow); border:1px solid var(--border);">
          <h2 style="font-family:'Lora',serif; color:var(--brown); margin-bottom:6px; font-size:1.5rem;">Send Us a Message</h2>
          <p style="color:var(--text-light); font-size:13px; margin-bottom:28px;">We'll get back to you within 24 hours.</p>

          <form action="/contact" method="POST">
            <div class="form-row">
              <div class="form-group">
                <label>Full Name *</label>
                <input type="text" name="name" placeholder="Your name" required>
              </div>
              <div class="form-group">
                <label>Phone Number *</label>
                <input type="tel" name="phone" placeholder="+91 XXXXX XXXXX" required>
              </div>
            </div>
            <div class="form-group">
              <label>Email Address *</label>
              <input type="email" name="email" placeholder="your@email.com" required>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Inquiry Type</label>
                <select name="type">
                  <option value="General">General Inquiry</option>
                  <option value="Order">Place Order</option>
                  <option value="Bulk">Bulk Order</option>
                  <option value="Complaint">Complaint</option>
                  <option value="Feedback">Feedback</option>
                </select>
              </div>
              <div class="form-group">
                <label>Subject *</label>
                <input type="text" name="subject" placeholder="Subject of your message" required>
              </div>
            </div>
            <div class="form-group">
              <label>Message *</label>
              <textarea name="message" placeholder="Tell us how we can help you..." required></textarea>
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%; justify-content:center;">Send Message</button>
          </form>
        </div>

        <div style="margin-top:16px; display:grid; grid-template-columns:1fr 1fr; gap:12px;">
          <a href="tel:+919876543210" class="btn btn-primary" style="justify-content:center; padding:16px;">Call Now</a>
          <a href="https://wa.me/919876543210" class="btn btn-green" style="justify-content:center; padding:16px;">WhatsApp</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section style="background: var(--white); padding: 60px 0; border-top: 1px solid var(--border);">
  <div class="container">
    <div class="section-header centered" style="margin-bottom:28px;">
      <div class="eyebrow">Location</div>
      <h2>Find Our Shop</h2>
    </div>
    <div class="map-placeholder" style="height:360px; max-width:800px; margin:0 auto;">
      <p style="font-size:16px;"><strong>Shree Dairy Farm</strong></p>
      <p>123, Dairy Lane, Near Bus Stand, Solapur, Maharashtra</p>
      <a href="https://maps.google.com/?q=Solapur,Maharashtra" target="_blank" class="btn btn-primary" style="margin-top:16px;">Open in Google Maps</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
